{
  "name": "paybridge",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paybridge-db",
      "database_id": "b0588f5e-3115-4e4d-b9f4-0988cc631f89"
    }
  ]
}
